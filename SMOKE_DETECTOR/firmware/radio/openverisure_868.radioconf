<?xml version="1.0" encoding="UTF-8"?>
<!-- OpenVerisure 868.950 MHz PHY for EFR32xG14 (nixi), compatible with the CC1110/CC1101 link:
     2-FSK +-21.4 kHz, 38.4 kbps, 32-bit 0xAA preamble, sync D391D391 (CC11xx SYNC_MODE 30/32 sends
     the 16-bit word twice), MSB first, no whitening, fixed 26 bytes = 24 payload + CRC-16 (0x8005,
     init 0xFFFF) appended in software. Regenerate src/autogen with the Gecko SDK radio configurator (see README.md). -->
