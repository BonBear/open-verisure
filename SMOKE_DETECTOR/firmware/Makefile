# GW-SD3 smoke detector firmware (EFR32FG14P231F256GM48), bare-metal arm-none-eabi-gcc + RAIL.
#
#   make GECKO_SDK=/path/to/gecko_sdk          # build build/smoke.{elf,hex,bin}
#   make GECKO_SDK=... flash                   # flash with pyOCD (CMSIS-DAP probe)
#
# GECKO_SDK must point at SiliconLabs/gecko_sdk v4.4.6 with the device files, CMSIS, emlib,
# rail_lib headers and librail_efr32xg14_gcc_release.a (see README.md).
# src/config.h (device ID + key) is generated by derive_key.py and git-ignored.

GECKO_SDK ?= C:/Tools/gecko_sdk_4.4.6
DEVICE    := EFR32FG14P231F256GM48
CROSS     ?= arm-none-eabi-
PYTHON    ?= py -3.12

CC      := $(CROSS)gcc
OBJCOPY := $(CROSS)objcopy
SIZE    := $(CROSS)size

DEV_DIR := $(GECKO_SDK)/platform/Device/SiliconLabs/EFR32FG14P
EMLIB   := $(GECKO_SDK)/platform/emlib
RAIL    := $(GECKO_SDK)/platform/radio/rail_lib
RAILLIB := $(RAIL)/autogen/librail_release/librail_efr32xg14_gcc_release.a
BUILD   := build
TARGET  := $(BUILD)/smoke

SRCS := src/main.c src/chamber_scan.c src/packet.c src/ctr_log.c src/radio.c src/battery.c src/power.c \
        src/autogen/rail_config.c \
        $(DEV_DIR)/Source/startup_efr32fg14p.c \
        $(DEV_DIR)/Source/system_efr32fg14p.c \
        $(addprefix $(EMLIB)/src/,em_cmu.c em_emu.c em_system.c em_core.c em_msc.c \
                                  em_crypto.c em_rmu.c em_gpio.c em_adc.c em_rtcc.c)
OBJS := $(addprefix $(BUILD)/,$(notdir $(SRCS:.c=.o)))
vpath %.c $(sort $(dir $(SRCS)))

CPUFLAGS := -mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=softfp
CFLAGS   := $(CPUFLAGS) -std=c99 -Os -g3 -Wall -Wextra -Werror \
            -ffunction-sections -fdata-sections \
            -D$(DEVICE) -D__START=main $(EXTRA_CFLAGS) \
            -Isrc -Isrc/autogen -I$(DEV_DIR)/Include -I$(EMLIB)/inc \
            -I$(RAIL)/common -I$(RAIL)/chip/efr32/efr32xg1x \
            -I$(GECKO_SDK)/platform/CMSIS/Core/Include \
            -I$(GECKO_SDK)/platform/common/inc
LDFLAGS  := $(CPUFLAGS) -T$(DEV_DIR)/Source/GCC/efr32fg14p.ld \
            --specs=nano.specs -nostartfiles \
            -Wl,--gc-sections -Wl,--no-warn-rwx-segments -Wl,-Map=$(TARGET).map -Wl,--print-memory-usage

.PHONY: all clean flash
all: $(TARGET).hex $(TARGET).bin

$(BUILD):
	mkdir -p $@

# SDK and generated sources are compiled without -Werror/-Wextra (vendor code).
PROJECT_SRC = $(filter-out src/autogen/%,$(filter src/%,$<))
$(BUILD)/%.o: %.c | $(BUILD)
	$(CC) $(if $(PROJECT_SRC),$(CFLAGS),$(filter-out -Werror -Wextra,$(CFLAGS)) -Wno-unused-const-variable) -c $< -o $@

$(TARGET).elf: $(OBJS)
	$(CC) $(LDFLAGS) $^ $(RAILLIB) -o $@
	$(SIZE) $@

$(TARGET).hex: $(TARGET).elf
	$(OBJCOPY) -O ihex $< $@

$(TARGET).bin: $(TARGET).elf
	$(OBJCOPY) -O binary $< $@

flash: $(TARGET).hex
	$(PYTHON) tools/flash.py $(TARGET).hex

clean:
	rm -rf $(BUILD)
