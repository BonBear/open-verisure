# ====================================================================
# Git Ignore for OpenVerisure: Embedded RF (TI CC1110 & ESP32 / CC1101)
# ====================================================================

# --- PlatformIO & ESP-IDF Build Artifacts ---
.pio/
.pioenvs/
.piolibdeps/
.clang_format

# --- SDCC (Small Device C Compiler) & 8051 Build Outputs ---
**/build/
*.rel
*.rst
*.sym
*.asm
*.lst
*.map
*.mem
*.ihx
*.lk
*.adb
*.cdb
*.omf

# --- Firmware Binaries & Temporary Dumps ---
*.bin
*.hex

# --- Local Secrets & Configs ---
VerisureDoorSensor/config.h
!VerisureDoorSensor/config.h.example
MD_CAM/firmware/config.h
!MD_CAM/firmware/config.h.example
868Receiver/src/secrets.h
!868Receiver/src/secrets.h.example
MD_CAM/cc_local_index.html
.env

# --- Python Environment & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# --- IDEs and Text Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Operating System & Temporary Files ---
scratch/
Thumbs.db
Desktop.ini
.DS_Store
*.log
*.tmp
*.bak
*.swp
*~

# --- Antigravity & Local Agent Tools ---
.antigravity/
.agents/*.json
.mcp.json
MD_CAM/blackfin/jtag/gdbproxy.log

# release packages (release/make_release.py)
dist/
