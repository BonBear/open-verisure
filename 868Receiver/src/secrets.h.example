/**
 * @file secrets.h.example
 * @brief Template for Local Gateway Credentials (Wi-Fi, MQTT & Master Key)
 *
 * HOW TO USE:
 * 1. Copy this template to `secrets.h` in the same directory:
 *      cp secrets.h.example secrets.h
 * 2. Put your own master key below (python derive_key.py --generate-master). Wi-Fi, MQTT and
 *    the web portal password are optional here: left out, the gateway opens its setup access
 *    point 'Verisure-Gateway' and you set them on its page.
 * 3. The `secrets.h` file is explicitly git-ignored to prevent leaking credentials.
 *
 * NOTE: Any settings configured via the Web Management Portal (/api/save) are
 * stored in ESP32 NVS (Preferences) and will override these compile-time defaults.
 */

#pragma once

// Wi-Fi (optional). Without an SSID the gateway starts its setup access point.
// #define DEFAULT_WIFI_SSID       "your-ssid"
// #define DEFAULT_WIFI_PASS       "your-wifi-password"

// MQTT broker (Home Assistant / Mosquitto), optional
// #define DEFAULT_MQTT_HOST       "192.168.0.100"
// #define DEFAULT_MQTT_PORT       1883
// #define DEFAULT_MQTT_USER       ""
// #define DEFAULT_MQTT_PASS       ""
// #define DEFAULT_MQTT_TOPIC      "verisure"

// Web portal password (optional, 8-64 characters), used while none is stored in NVS. Without it
// the first setup in the access point asks for one; on a gateway already on Wi-Fi set it with
// the serial command "portalpass <password>". Only a salted hash is stored.
// #define DEFAULT_PORTAL_PASS     "change-me-please"

// Setup access point password (optional, 8-63 characters). Without it every gateway derives its
// own from its MAC; the serial console shows it (at boot, every minute in AP mode, "appass").
// #define DEFAULT_AP_PASS         "change-me-too"

// 16-Byte Master AES Key in Hex (32 hex characters)
// This MUST match the Master Key used to derive sensor keys with derive_key.py!
// Generate a secure random key with: python derive_key.py --generate-master
// The value below is the PUBLIC example key: the gateway warns at boot and on its page while
// it is in use, because anyone can make packets with it.
#define MASTER_KEY_HEX          "0102030405060708090A0B0C0D0E0F10"

// CC1101 frequency correction in FSCTRL0 steps of 1.587 kHz (default 0). Only if the received
// packets log a large "Freq. error" (a module with a crystal far off); can also be set later
// with the serial command "freqoffset <n>".
// #define DEFAULT_FREQ_OFFSET     0
